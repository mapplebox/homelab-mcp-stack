# Secrets: only *.example files belong in git
.env
.env.*
*.env
!*.example
!.env.example
!*.env.example

# Real configs (hold API tokens)
config.json
!config.example.json

# Runtime data of the containers
auth-data/
data/
pki/

# Keys and certificates: never commit any
*.key
*.pem
*.crt
*.cer
*.der
*.csr
*.srl
*.p12
*.pfx
*.jks

# Logs / local state
*.log
*.sqlite3
.DS_Store
