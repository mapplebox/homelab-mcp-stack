# Copy to site.env (no secrets in here)
# IP of the UniFi console / gateway of this site
UNIFI_NETWORK_HOST=192.168.1.1
# Complete list of Host headers the server accepts (DNS rebinding protection). Include the name Caddy forwards.
UNIFI_MCP_ALLOWED_HOSTS=mcp-unifi.int.example.com,localhost,127.0.0.1
