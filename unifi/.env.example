# Copy to .env and run: chmod 600 .env
# Local UniFi account (UniFi OS > Admins & Users), without SSO and without 2FA.
# Give it only the role it needs.
UNIFI_NETWORK_USERNAME=<local-unifi-user>
UNIFI_NETWORK_PASSWORD=CHANGE_ME
# your timezone, e.g. Europe/Berlin
TZ=UTC
# Bearer token that Caddy checks for mcp-unifi.int.example.com (the container does not read it).
# Create with: openssl rand -hex 32
BEARER_TOKEN=CHANGE_ME
