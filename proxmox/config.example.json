{
    "proxmox": {
        "host": "192.168.1.5",
        "port": 8006,
        "verify_ssl": true,
        "service": "PVE"
    },
    "auth": {
        "user": "mcp@pve",
        "token_name": "mcp",
        "token_value": "<token-secret-from-pveum>"
    },
    "logging": {
        "level": "INFO"
    },
    "mcp": {
        "host": "0.0.0.0",
        "port": 8000,
        "transport": "STREAMABLE"
    },
    "jobs": {
        "sqlite_path": "/var/lib/proxmox-mcp/proxmox-jobs.sqlite3"
    },
    "command_policy": {
        "mode": "deny_all",
        "allow_patterns": [],
        "deny_patterns": [
            "(^|\\s)rm\\s+-rf(\\s|$)",
            ":\\(\\)\\{:\\|:\\&\\};:"
        ],
        "require_approval_token": false,
        "approval_token": null
    }
}
