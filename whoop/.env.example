# Copy to .env and run: chmod 600 .env
# From your app at developer.whoop.com (redirect URI: https://whoop.example.com/callback)
WHOOP_CLIENT_ID=<whoop-client-id>
WHOOP_CLIENT_SECRET=CHANGE_ME
# Password for the OAuth login page of this server, at least 16 characters
MCP_AUTH_PASSWORD=CHANGE_ME
# Encrypts the stored WHOOP tokens in ./data. Create with: openssl rand -hex 32
# If you change it later, the stored tokens can not be read anymore and you log in to WHOOP again.
ENCRYPTION_SECRET=CHANGE_ME
# your timezone, e.g. Europe/Berlin
TZ=UTC
