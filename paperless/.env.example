# Copy to .env and run: chmod 600 .env
# API token of a Paperless user (Paperless > My Profile > API Auth Token).
# Claude gets exactly the rights of this user.
PAPERLESS_API_KEY=CHANGE_ME
# your timezone, e.g. Europe/Berlin
TZ=UTC
# Bearer token that Caddy checks for mcp-paperless.int.example.com (the container does not read it).
# Create with: openssl rand -hex 32
BEARER_TOKEN=CHANGE_ME
